DECLARE @ViewName NVARCHAR(255) = N'dbo.ViewName';


SELECT 
    (SELECT OBJECT_DEFINITION(OBJECT_ID(@ViewName)) + CHAR(13) + CHAR(10) + 'GO' + CHAR(13) + CHAR(10)) +
    ISNULL(
        (
        SELECT 
            'CREATE ' + CASE WHEN i.is_unique = 1 THEN 'UNIQUE ' ELSE '' END + 
            i.type_desc + ' INDEX [' + i.name + '] ON [' + SCHEMA_NAME(v.schema_id) + '].[' + v.name + '] (' +
            STUFF((
                SELECT ', [' + c.name + ']' + CASE WHEN ic.is_descending_key = 1 THEN ' DESC' ELSE ' ASC' END
                FROM sys.index_columns ic
                JOIN sys.columns c ON ic.object_id = c.object_id AND ic.column_id = c.column_id
                WHERE ic.object_id = i.object_id AND ic.index_id = i.index_id AND ic.is_included_column = 0
                ORDER BY ic.key_ordinal    
                FOR XML PATH('')
            ), 1, 2, '') + ')' +
            ISNULL(' INCLUDE (' + STUFF((
                SELECT ', [' + c.name + ']'
                FROM sys.index_columns ic
                JOIN sys.columns c ON ic.object_id = c.object_id AND ic.column_id = c.column_id
                WHERE ic.object_id = i.object_id AND ic.index_id = i.index_id AND ic.is_included_column = 1
                ORDER BY ic.index_column_id
                FOR XML PATH('')
            ), 1, 2, '') + ')', '') + ';' + CHAR(13) + CHAR(10) + 'GO' + CHAR(13) + CHAR(10)
        FROM sys.indexes i
        JOIN sys.views v ON i.object_id = v.object_id
        WHERE i.object_id = OBJECT_ID(@ViewName) AND i.index_id > 0
        FOR XML PATH(''), TYPE
        ).value('.', 'NVARCHAR(MAX)')
    , '') AS FullScript;
